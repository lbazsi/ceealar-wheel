{
  "name": "CEEALAR \u00b7 noodles",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install -e .",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "CEEALAR lightning talks",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
  }
}
